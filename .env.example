# Copy to .env and fill these values when you are ready to send messages.

# WxPusher standard app token.
WXPUSHER_APP_TOKEN=

# Comma-separated WxPusher UIDs for initial personal testing.
WXPUSHER_UIDS=

# Optional: comma-separated WxPusher topic IDs for later group delivery.
WXPUSHER_TOPIC_IDS=

# Digest behavior.
DIGEST_TIMEZONE=Asia/Shanghai
DIGEST_MAX_ITEMS_PER_CHANNEL=5
MAX_ITEMS_PER_SOURCE=20

# Pixabay API for cover image generation. Free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Local file paths.
DATABASE_PATH=data/knowledge_radar.sqlite3
SOURCES_PATH=config/sources.json
OUTPUT_DIR=out
